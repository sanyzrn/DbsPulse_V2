# نمونه پیکربندی Nginx برای اجرا روی خود سرور (بیرون از docker-compose) که HTTPS را
# terminate می‌کند و به کانتینر frontend (که با docker-compose روی پورت 8080 منتشر شده) پاس می‌دهد.
# کانتینر frontend خودش درخواست‌های /api/ را به کانتینر backend پروکسی می‌کند، پس این
# Nginx بیرونی فقط یک لایه TLS/دامنه اضافه می‌کند و نیازی به تنظیم جداگانه برای /api ندارد.
#
# نصب:
#   1. این فایل را به /etc/nginx/sites-available/dbspulse.conf کپی کنید و دامنه را جایگزین کنید.
#   2. برای گواهی رایگان: sudo certbot --nginx -d your-domain.example.com
#      (certbot به‌صورت خودکار بلوک‌های ssl_certificate را اضافه/تمدید می‌کند)
#   3. ln -s /etc/nginx/sites-available/dbspulse.conf /etc/nginx/sites-enabled/
#   4. nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name your-domain.example.com;

    # certbot این بلوک را برای اعتبارسنجی ACME استفاده می‌کند؛ بقیه درخواست‌ها به HTTPS ریدایرکت می‌شوند
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name your-domain.example.com;

    # این دو خط را certbot به‌صورت خودکار پر می‌کند
    # ssl_certificate     /etc/letsencrypt/live/your-domain.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain.example.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=63072000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
