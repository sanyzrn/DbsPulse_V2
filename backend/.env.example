# development | production — در production اگر JWT_SECRET_KEY مقدار پیش‌فرض بماند، استارت‌آپ عمداً fail می‌شود
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://dbspulse:dbspulse_dev_password@localhost:5432/dbspulse

# پیش از استقرار واقعی حتماً یک مقدار تصادفی و طولانی جایگزین کنید (مثلاً: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# دامنه‌های مجاز CORS، جدا شده با کاما (بدون فاصله اضافی لازم نیست)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# آدرس عمومی فرانت‌اند؛ داخل QR تأیید اصالت سند PDF قرار می‌گیرد
PUBLIC_BASE_URL=http://localhost:8080

# کمترین تعداد ارزیابی که یک میانگین تجمیعی باید داشته باشد تا نمایش داده شود.
# «میانگین واحد» روی دو نفر، آمار گروه نیست؛ عملاً امتیاز همان دو نفر است.
# مقدار ۱ یعنی سرکوب خاموش (فقط برای محیط‌های کوچک آزمایشی).
MIN_COHORT_SIZE=5

# قفل حساب پس از تلاش‌های ناموفق ورود (به ازای نام کاربری، در دیتابیس).
# محدودیت per-IP یک حملهٔ توزیع‌شده روی یک حساب مشخص را نمی‌گیرد؛ این می‌گیرد.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# محل شمارندهٔ محدودیت نرخِ per-IP. خالی = حافظهٔ درون‌پروسه (با N کارگر، N برابر
# می‌شود و با ری‌استارت صفر). برای چند instance: redis://redis:6379
RATE_LIMIT_STORAGE_URI=

# IP/شبکهٔ reverse proxy که X-Forwarded-For اش قابل اعتماد است.
# در توسعه بک‌اند مستقیم صدا زده می‌شود؛ در production «*» باعث خطای استارت‌آپ می‌شود.
FORWARDED_ALLOW_IPS=*

# ساخت کاربران/پرسنل نمونهٔ دمو (hr1, sup1, sup2, dep1, ceo1) هنگام اجرای مایگریشن‌ها.
# رمز مشترکشان در مخزن عمومی است، پس فقط برای توسعهٔ محلی. در production باید false بماند
# (در غیر این صورت استارت‌آپ عمداً fail می‌شود).
SEED_DEMO_DATA=false

# زمان‌بند درون‌پروسه برای اعلان‌های فعالانه (انقضای قرارداد + تأخیر مراحل).
# با چند instance هم امن است: قفل رهبریِ Postgres تضمین می‌کند فقط یکی واقعاً جارو
# می‌زند و بقیه رد می‌شوند. تاریخچهٔ اجرا در /api/admin/scheduler-runs دیده می‌شود.
ENABLE_SCHEDULER=true
# ۵ دقیقه — جاروی اعلان‌های زمان‌محور. اعلان‌های رویدادمحور هم‌زمان ساخته می‌شوند.
SCHEDULER_INTERVAL_SECONDS=300
CONTRACT_EXPIRY_ALERT_DAYS=30
SLA_REMINDER_DAYS=3
NOTIFICATION_DEDUP_DAYS=7

# ─── تحویل بیرونی اعلان‌ها (P1-03) ───────────────────────────────────────────
# همه‌چیز پیش‌فرض خاموش است. تا وقتی هیچ‌کدام تنظیم نشده باشند، اعلان‌ها فقط
# درون‌برنامه‌ای می‌مانند و رفتار سامانه دقیقاً همان چیزی است که بود.

# حالت توسعه: به‌جای ارسال واقعی، پیام‌ها در لاگ نوشته می‌شوند. برای آزمودن کل
# زنجیره (صف، تلاش مجدد، ارجحیت کاربر) بدون هیچ سرویس بیرونی.
# NOTIFICATION_CHANNEL_CONSOLE=true

# --- ایمیل: SMTP استاندارد، پس با میل‌سرور داخلی و هر سرویس تراکنشی کار می‌کند
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=dbspulse@example.com
# SMTP_USE_STARTTLS=true

# --- پیامک: شکل درخواست از همین‌جا می‌آید، پس وصل‌کردن یک سرویس تازه بدون
# تغییر کد ممکن است. جای‌گزین‌ها: {recipient} {message} {api_key}
#
# نمونهٔ ۱ — سرویسی که با GET و پارامتر کار می‌کند:
# SMS_URL=https://api.example.com/v1/{api_key}/sms/send.json?receptor={recipient}&message={message}
# SMS_METHOD=GET
# SMS_API_KEY=xxxxxxxx
#
# نمونهٔ ۲ — سرویسی که JSON می‌خواهد:
# SMS_URL=https://api.example.com/v1/send/simple
# SMS_METHOD=POST
# SMS_HEADERS={"x-api-key": "{api_key}"}
# SMS_BODY={"lineNumber": "3000xxxx", "messageText": "{message}", "mobiles": ["{recipient}"]}
# SMS_API_KEY=xxxxxxxx
#
# اگر سرویس روی خطا هم ۲۰۰ می‌دهد، این رشته باید در بدنهٔ پاسخِ موفق باشد:
# SMS_SUCCESS_CONTAINS="status":200

# سقف تلاش و عقب‌نشینی نمایی (تلاش دوم پس از ۵ دقیقه، سومی ۱۰، چهارمی ۲۰ …)
# DELIVERY_MAX_ATTEMPTS=5
# DELIVERY_RETRY_BASE_MINUTES=5
