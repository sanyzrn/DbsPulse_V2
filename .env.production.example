# ---------------------------------------------------------------------------
# نمونهٔ پیکربندی production برای اجرای استک با docker compose.
#
#   cp .env.production.example .env      # کنار همین docker-compose.yml
#
# مقادیر زیر «باید» پر شوند — هیچ‌کدام پیش‌فرض امنی ندارند. برنامه در حالت
# ENVIRONMENT=production عمداً fail-closed است: اگر هرکدام از این‌ها روی مقدار
# توسعه‌ای بماند، بک‌اند به‌جای اجرای ناامن، با خطای صریح بالا نمی‌آید.
# (گاردها: backend/app/core/config.py و backend/app/core/startup_checks.py)
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# رمز کاربر Postgres. یک مقدار تصادفی بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# کلید امضای توکن‌ها. عوض کردنش همهٔ نشست‌های فعال را باطل می‌کند.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# اگر مقدار پیش‌فرض دمو بماند، استارت‌آپ fail می‌شود.
JWT_SECRET_KEY=

# دامنهٔ واقعی فرانت‌اند، با https. کوکی رفرش در production پرچم Secure می‌گیرد،
# پس origin غیر-https اصلاً کار نمی‌کند. چند دامنه را با کاما جدا کنید.
# localhost/127.0.0.1 یا http ساده باعث خطای استارت‌آپ می‌شود.
CORS_ORIGINS=https://dbspulse.example.com

# آدرس عمومی فرانت‌اند؛ داخل QR سند PDF می‌رود، پس باید از بیرون سازمان هم باز شود.
PUBLIC_BASE_URL=https://dbspulse.example.com

# IP یا شبکهٔ reverse proxy جلویی (مثلاً 172.18.0.0/16 در شبکهٔ docker، یا IP لودبالانسر).
# با «*» هر کلاینتی می‌تواند X-Forwarded-For جعلی بفرستد و محدودیت نرخ ورود را دور بزند.
FORWARDED_ALLOW_IPS=

# زمان‌بند اعلان‌های زمان‌محور (انقضای قرارداد، تأخیر مراحل).
# ⚠️ درون‌پروسه است: فقط با «یک» replica از بک‌اند روشنش کنید، وگرنه هر replica
# جداگانه اجرا می‌کند و اعلان تکراری ساخته می‌شود.
ENABLE_SCHEDULER=true

# کاربران نمونه با رمز مشترکِ منتشرشده در مخزن. در production باید false بماند —
# true بودنش باعث خطای صریح استارت‌آپ می‌شود.
SEED_DEMO_DATA=false
