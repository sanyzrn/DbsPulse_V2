server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # هدرهای امنیتی: CSP سخت‌گیرانه (فونت‌ها self-host هستند)، منع iframe (کلیک‌جکینگ
    # روی دکمه‌های تأیید)، منع MIME sniffing و محدودکردن Referrer.
    # توجه: در nginx اگر یک location خودش add_header داشته باشد، هدرهای سطح server
    # را به ارث نمی‌برد؛ برای همین در /assets/ هدر nosniff تکرار شده است.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    # فایل‌های استاتیک با کش طولانی (نام‌گذاری هش‌شده توسط Vite)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # پروکسی درخواست‌های API به سرویس بک‌اند.
    # BACKEND_ORIGIN را با متغیر محیطی تنظیم کنید: در docker-compose پیش‌فرض
    # http://backend:8000 کار می‌کند؛ روی Railway/Render باید به آدرس عمومی یا
    # داخلی سرویس بک‌اند مقداردهی شود.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # مسیریابی سمت کلاینت (React Router) — بازگشت به index.html
    location / {
        try_files $uri /index.html;
    }
}
