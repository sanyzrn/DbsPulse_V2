# پروتکل مؤثر: اگر پروکسی بالادستی (لودبالانسر/CDN) هدر X-Forwarded-Proto فرستاده
# باشد همان ملاک است، وگرنه اسکیم خودِ این اتصال. بدون این تفکیک، در استقراری که
# TLS را لایهٔ جلوتر تمام می‌کند، $scheme همیشه http است و HSTS هرگز فرستاده نمی‌شود.
map $http_x_forwarded_proto $dbspulse_effective_scheme {
    default $scheme;
    ""      $scheme;
    https   https;
    http    http;
}

# HSTS فقط روی HTTPS. فرستادنش روی HTTP بی‌اثر نیست — خطرناک است: مرورگر همان
# نام میزبان را برای یک سال به HTTPS سنجاق می‌کند، و یک استقرار توسعه/داخلی که
# عمداً HTTP است از دسترس خارج می‌شود. nginx هدر با مقدار خالی را اصلاً اضافه نمی‌کند.
#
# includeSubDomains عمداً هست: استقرار این محصول تک‌مستأجر و روی نام میزبان
# اختصاصی است. اگر روی همان دامنه زیردامنه‌ای دارید که باید HTTP بماند، این بخش
# را بردارید. `preload` عمداً نیست — ثبت در فهرست preload یک تصمیم برگشت‌ناپذیر
# است و باید آگاهانه و دستی انجام شود.
map $dbspulse_effective_scheme $dbspulse_hsts {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # هدرهای امنیتی: CSP سخت‌گیرانه (فونت‌ها self-host هستند)، منع iframe (کلیک‌جکینگ
    # روی دکمه‌های تأیید)، منع MIME sniffing و محدودکردن Referrer.
    # توجه: در nginx اگر یک location خودش add_header داشته باشد، هدرهای سطح server
    # را به ارث نمی‌برد؛ برای همین در /assets/ هدر nosniff تکرار شده است.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security $dbspulse_hsts always;

    # nginx در mime.types پیش‌فرضش نگاشتی برای .webmanifest ندارد و آن را
    # application/octet-stream می‌فرستد؛ در آن حالت کروم مانیفست را نادیده
    # می‌گیرد و برنامه با اینکه همه‌چیزش درست است «قابل نصب» نمی‌شود (P2-04).
    types {
        application/manifest+json  webmanifest;
    }

    # سرویس‌ورکر هرگز نباید کش شود.
    # نسخهٔ کش‌شدهٔ sw.js یعنی کاربر روی یک استراتژیِ کشِ قدیمی گیر می‌کند — و چون
    # خودِ همان ورکر است که تصمیم می‌گیرد چه چیزی از شبکه بیاید، این حالت خودش
    # خودش را نگه می‌دارد و با استقرار بعدی هم پاک نمی‌شود.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security $dbspulse_hsts always;
    }

    # فایل‌های استاتیک با کش طولانی (نام‌گذاری هش‌شده توسط Vite)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        # اگر نخستین درخواست کاربر مستقیماً به یک asset باشد، بدون این خط سیاست
        # HSTS را در آن پاسخ نمی‌گرفت (add_header سطح server ارث نمی‌رسد).
        add_header Strict-Transport-Security $dbspulse_hsts always;
    }

    # پروکسی درخواست‌های API به سرویس بک‌اند.
    # BACKEND_ORIGIN را با متغیر محیطی تنظیم کنید: در docker-compose پیش‌فرض
    # http://backend:8000 کار می‌کند؛ روی Railway/Render باید به آدرس عمومی یا
    # داخلی سرویس بک‌اند مقداردهی شود.
    location /api/ {
        # سقفِ آپلود باید با سقفی که خودِ بک‌اند قبول می‌کند یکی باشد (L-3): ورود
        # اکسلِ پرسنل تا ۵ مگابایت و آپلودِ فایل در دستیار تا ۲۰ مگابایت (سقفِ
        # schema). بدون این خط، پیش‌فرضِ nginx (۱ مگابایت) فایلِ بزرگ‌تر را با
        # 413 مبهم پشتِ پراکسی می‌کُشت — قبل از اینکه خطایِ معنادارِ بک‌اند برسد.
        client_max_body_size 20m;
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # عمداً $remote_addr و نه $proxy_add_x_forwarded_for: حالت دوم هدرِ فرستادهٔ
        # خودِ کلاینت را به ابتدای زنجیره اضافه می‌کرد، پس آدرسی که بک‌اند محدودیت
        # نرخ ورود را روی آن کلید می‌زد توسط مهاجم قابل کنترل بود — با چرخاندن یک
        # هدر، شمارنده صفر می‌شد. این‌جا هرچه کلاینت فرستاده باشد دور ریخته می‌شود
        # و فقط آدرس واقعیِ اتصال می‌ماند.
        #
        # اگر پروکسی دیگری (CDN/لودبالانسر) جلوی همین nginx هست، $remote_addr آدرسِ
        # آن پروکسی است نه کلاینت؛ در آن صورت این دو خط را اضافه کنید تا nginx خودش
        # آدرس واقعی را از زنجیره دربیاورد:
        #     set_real_ip_from <شبکهٔ آن پروکسی>;
        #     real_ip_header X-Forwarded-For;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # مسیریابی سمت کلاینت (React Router) — بازگشت به index.html
    location / {
        try_files $uri /index.html;
    }
}
