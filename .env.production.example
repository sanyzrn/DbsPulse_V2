# ---------------------------------------------------------------------------
# نمونهٔ پیکربندی production برای اجرای استک با docker compose.
#
#   cp .env.production.example .env      # کنار همین docker-compose.yml
#
# مقادیر زیر «باید» پر شوند — هیچ‌کدام پیش‌فرض امنی ندارند. برنامه در حالت
# ENVIRONMENT=production عمداً fail-closed است: اگر هرکدام از این‌ها روی مقدار
# توسعه‌ای بماند، بک‌اند به‌جای اجرای ناامن، با خطای صریح بالا نمی‌آید.
# (گاردها: backend/app/core/config.py و backend/app/core/startup_checks.py)
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# رمز کاربر Postgres. یک مقدار تصادفی بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# کلید امضای توکن‌ها. عوض کردنش همهٔ نشست‌های فعال را باطل می‌کند.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# اگر مقدار پیش‌فرض دمو بماند، استارت‌آپ fail می‌شود.
JWT_SECRET_KEY=

# دامنهٔ واقعی فرانت‌اند، با https. کوکی رفرش در production پرچم Secure می‌گیرد،
# پس origin غیر-https اصلاً کار نمی‌کند. چند دامنه را با کاما جدا کنید.
# localhost/127.0.0.1 یا http ساده باعث خطای استارت‌آپ می‌شود.
CORS_ORIGINS=https://dbspulse.example.com

# آدرس عمومی فرانت‌اند؛ داخل QR سند PDF می‌رود، پس باید از بیرون سازمان هم باز شود.
PUBLIC_BASE_URL=https://dbspulse.example.com

# IP یا شبکهٔ reverse proxy جلویی (مثلاً 172.18.0.0/16 در شبکهٔ docker، یا IP لودبالانسر).
# با «*» هر کلاینتی می‌تواند X-Forwarded-For جعلی بفرستد و محدودیت نرخ ورود را دور بزند؛
# به همین دلیل «*» در production باعث خطای صریح استارت‌آپ می‌شود.
FORWARDED_ALLOW_IPS=172.18.0.0/16

# محل شمارندهٔ محدودیت نرخِ per-IP. خالی = حافظهٔ درون‌پروسه، که فقط با «یک» کارگر
# درست کار می‌کند: با N کارگر هر محدودیت عملاً N برابر می‌شود و ری‌استارت پاکش می‌کند.
# برای استقرار چندنسخه‌ای یک backend مشترک بدهید، مثلاً: redis://redis:6379
# (قفلِ حسابِ per-username به این وابسته نیست — همیشه در دیتابیس مشترک است.)
RATE_LIMIT_STORAGE_URI=

# زمان‌بند اعلان‌های زمان‌محور (انقضای قرارداد، تأخیر مراحل).
# با چند replica هم امن است: قفل توصیه‌ای Postgres رهبر را انتخاب می‌کند و بقیه رد
# می‌شوند. هر اجرا (موفق/ناموفق/ردشده) در /api/admin/scheduler-runs ثبت می‌شود.
ENABLE_SCHEDULER=true

# کاربران نمونه با رمز مشترکِ منتشرشده در مخزن. در production باید false بماند —
# true بودنش باعث خطای صریح استارت‌آپ می‌شود.
SEED_DEMO_DATA=false

# توکن اسکرپ سنجه‌ها (P1-12). تا وقتی خالی است، /metrics اصلاً وجود ندارد (۴۰۴).
# سنجه‌ها نام مسیرها، حجم ترافیک و نرخ خطا را لو می‌دهند، پس نباید بی‌احراز هویت
# منتشر شوند. Prometheus باید با هدر `Authorization: Bearer <token>` اسکرپ کند.
METRICS_TOKEN=

# پورتی که سامانه روی سرور منتشر می‌کند (پشت nginx/HTTPS).
HTTP_PORT=8080

# نخستین حساب مدیر سامانه. اگر رمز را خالی بگذارید، یک رمز تصادفی ساخته و
# فقط یک‌بار در لاگ استارت‌آپ نوشته می‌شود:
#   docker compose -f docker-compose.prod.yml logs backend | grep -i admin
# در هر دو حالت، تغییر رمز در نخستین ورود اجباری است.
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
DBSPULSE_ADMIN_USERNAME=admin
DBSPULSE_ADMIN_PASSWORD=

# رمز SMTP و کلید API پیامک عمداً فقط از این فایل خوانده می‌شوند و هرگز در
# دیتابیس ذخیره نمی‌شوند — چیزی که در دیتابیس بنشیند در هر بک‌آپی هم می‌نشیند.
# بقیهٔ تنظیمات ایمیل/پیامک از پنل مدیریت قابل ویرایش‌اند.
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_API_KEY=
